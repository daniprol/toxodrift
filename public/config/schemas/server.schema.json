{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "default": "ToxoDrift server",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "port": {
      "default": 2567,
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "origins": {
      "default": [
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "trustedProxies": {
      "default": [],
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "format": "ipv4",
            "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$"
          },
          {
            "type": "string",
            "format": "ipv6",
            "pattern": "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$"
          },
          {
            "type": "string",
            "format": "cidrv4",
            "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\/([0-9]|[1-2][0-9]|3[0-2])$"
          },
          {
            "type": "string",
            "format": "cidrv6",
            "pattern": "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))\\/(12[0-8]|1[01][0-9]|[1-9]?[0-9])$"
          }
        ]
      }
    },
    "httpRequestsPerMinute": {
      "default": 180,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "patchRate": {
      "default": 20,
      "type": "integer",
      "minimum": 10,
      "maximum": 60
    },
    "inputRate": {
      "default": 35,
      "type": "integer",
      "minimum": 10,
      "maximum": 70
    },
    "inputTimeoutMs": {
      "default": 500,
      "type": "integer",
      "minimum": 100,
      "maximum": 5000
    },
    "reconnectSeconds": {
      "default": 20,
      "type": "number",
      "minimum": 0,
      "maximum": 120
    },
    "lobbyTimeoutSeconds": {
      "default": 600,
      "type": "number",
      "exclusiveMinimum": 0
    },
    "finishGraceSeconds": {
      "default": 30,
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maxRooms": {
      "default": 32,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "recoverCooldownMs": {
      "default": 3000,
      "type": "integer",
      "minimum": 100,
      "maximum": 9007199254740991
    },
    "resultRetentionSeconds": {
      "default": 120,
      "type": "number",
      "exclusiveMinimum": 0
    },
    "settlementRetrySeconds": {
      "default": 2,
      "type": "number",
      "exclusiveMinimum": 0
    },
    "ranking": {
      "default": {
        "initialElo": 1000,
        "kFactor": 32,
        "scale": 400,
        "finishPoints": [
          20,
          12,
          8,
          5,
          3,
          1
        ],
        "aiBeatPoints": 2,
        "soloMultiplier": 0.5,
        "dailyPointsCap": 200,
        "minRaceSeconds": 20
      },
      "type": "object",
      "properties": {
        "initialElo": {
          "default": 1000,
          "type": "number",
          "minimum": 0
        },
        "kFactor": {
          "default": 32,
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "scale": {
          "default": 400,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "finishPoints": {
          "default": [
            20,
            12,
            8,
            5,
            3,
            1
          ],
          "minItems": 6,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "aiBeatPoints": {
          "default": 2,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "soloMultiplier": {
          "default": 0.5,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dailyPointsCap": {
          "default": 200,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "minRaceSeconds": {
          "default": 20,
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "initialElo",
        "kFactor",
        "scale",
        "finishPoints",
        "aiBeatPoints",
        "soloMultiplier",
        "dailyPointsCap",
        "minRaceSeconds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "port",
    "origins",
    "trustedProxies",
    "httpRequestsPerMinute",
    "patchRate",
    "inputRate",
    "inputTimeoutMs",
    "reconnectSeconds",
    "lobbyTimeoutSeconds",
    "finishGraceSeconds",
    "maxRooms",
    "recoverCooldownMs",
    "resultRetentionSeconds",
    "settlementRetrySeconds",
    "ranking"
  ],
  "additionalProperties": false
}
