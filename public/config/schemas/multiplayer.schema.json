{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "servers": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "name",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "localhostPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "interpolationMs": {
      "type": "number",
      "minimum": 0,
      "maximum": 250
    }
  },
  "required": [
    "servers",
    "localhostPort",
    "interpolationMs"
  ],
  "additionalProperties": false
}
