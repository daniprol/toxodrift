{
  "$schema": "./schemas/game.schema.json",
  // Stock easy-difficulty cars. Steering is degrees/tick (3.75 / original divisor).
  // Armor includes the original level-zero package (+360); driver bonuses apply at race creation.
  // Health/ammo are percentages; gunAmmoCost is the original 260 / 1024 per tick.
  // Race equations use original 70 Hz tick units.
  "race": {
    "tickRate": 70,
    "laps": 4,
    "countdownSeconds": 3,
    "maxRaceSeconds": 600,
    "defaultTrack": "tr1",
    "defaultCar": "vagabond",
    "opponents": 3,
    "weapons": true,
  },
  "physics": {
    "drag": 0.98,
    "throttleDrag": 0.986,
    "acceleration": 0.8,
    "turboAcceleration": 1.3,
    "accelerationDivisor": 30,
    "brakeDivisor": 90,
    "verticalScale": 0.833333,
    "slipDivisor": 11,
    "steeringMemory": 36,
    "steeringBuild": 2,
    "steeringDecay": 1,
    "collisionRadius": 10,
    "wallBounce": 0.35,
    "collisionDamage": 0.25,
    // MAS low nibble: 0–3 walls, 4–10 surfaces, 11 boost, 15 ordinary road.
    "terrainDrag": [
      1, 1, 1, 1, 0.97142857, 0.96666667, 0.88888889, 0.95, 0.95, 1, 1, 1, 1, 1, 1, 1,
    ],
    "turboCapacity": 102400,
    "turboDrain": 400,
    "turboRecharge": 20,
  },
  "combat": {
    "health": 100,
    "ammo": 100,
    "mines": 8,
    "gunInterval": 0.014285714285714285,
    "gunAmmoCost": 0.25390625,
    "weaponSafetyTicks": 240,
    "gunRange": 125,
    "mineInterval": 0.7142857142857143,
    "mineArmSeconds": 0.5,
    "mineRadius": 20,
    "mineDamage": 20,
    "pickupRespawnSeconds": 12,
    "pickupRadius": 18,
    "repairAmount": 15,
  },
  "ai": {
    "lookAhead": 40,
    "sensorAngle": 26,
    "leftThreshold": 7,
    "rightThreshold": 9,
    "stuckSeconds": 1.5,
    "recoverySeconds": 0.8,
    "cornerSpeedFactor": 1,
    "brakingMargin": 1.1,
  },
  "display": {
    "width": 320,
    "height": 200,
    "cameraLead": 35,
    "maxFrameSeconds": 0.1,
    "colors": ["#bedb43", "#dc6358", "#6caaca", "#e8bc5e"],
  },
  "audio": {
    "enabled": true,
    "musicVolume": 0.25,
    "effectsVolume": 0.5,
    "engineVolume": 0.18,
    "readySample": 3,
    "finishSample": 5,
    "gunSample": 19,
    "collisionSample": 10,
  },
  "controls": {
    "accelerate": ["ArrowUp", "KeyW"],
    "brake": ["ArrowDown", "KeyS"],
    "left": ["ArrowLeft", "KeyA"],
    "right": ["ArrowRight", "KeyD"],
    "turbo": ["ShiftLeft", "ShiftRight"],
    "fire": ["Space", "ControlLeft"],
    "mine": ["KeyX"],
    "pause": ["Escape", "KeyP"],
    "recover": ["KeyR"],
  },
  "cars": [
    {
      "id": "vagabond",
      "name": "Vagabond",
      "sprite": "kupla",
      "engine": 2.55,
      "engineSample": 25,
      "steering": 2.0833333333333335,
      "tireSlip": 0.5,
      "size": 8.3,
      "armor": 480,
      "gunDamage": 0.2,
      "speedMph": 55,
    },
    {
      "id": "dervish",
      "name": "Dervish",
      "sprite": "pickup",
      "engine": 2.7,
      "engineSample": 26,
      "steering": 2.2058823529411766,
      "tireSlip": 0.5,
      "size": 9.7,
      "armor": 490,
      "gunDamage": 0.35,
      "speedMph": 65,
    },
    {
      "id": "sentinel",
      "name": "Sentinel",
      "sprite": "sedan",
      "engine": 2.9,
      "engineSample": 27,
      "steering": 2.34375,
      "tireSlip": 0.8,
      "size": 9,
      "armor": 500,
      "gunDamage": 0.5,
      "speedMph": 80,
    },
    {
      "id": "shrieker",
      "name": "Shrieker",
      "sprite": "camaro",
      "engine": 3.25,
      "engineSample": 28,
      "steering": 2.4193548387096775,
      "tireSlip": 0.8,
      "size": 10.5,
      "armor": 590,
      "gunDamage": 0.65,
      "speedMph": 90,
    },
    {
      "id": "wraith",
      "name": "Wraith",
      "sprite": "porche",
      "engine": 3.7,
      "engineSample": 29,
      "steering": 2.586206896551724,
      "tireSlip": 0.8,
      "size": 8.5,
      "armor": 660,
      "gunDamage": 0.8,
      "speedMph": 115,
    },
    {
      "id": "deliverator",
      "name": "Deliverator",
      "sprite": "lotus",
      "engine": 4.05,
      "engineSample": 30,
      "steering": 2.678571428571429,
      "tireSlip": 0.8,
      "size": 9.2,
      "armor": 710,
      "gunDamage": 0.95,
      "speedMph": 140,
    },
  ],
}
