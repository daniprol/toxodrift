{
  "name": "toxodrift",
  "version": "0.1.0",
  "private": true,
  "description": "A TypeScript port of Death Rally's racing engine, evolving into ToxoDrift.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "assets:download": "tsx scripts/download-assets.ts",
    "assets:import": "tsx scripts/import-assets.ts",
    "assets:setup": "pnpm assets:download && pnpm assets:import && pnpm assets:audio",
    "schemas": "tsx scripts/export-schemas.ts",
    "hooks:install": "lefthook install",
    "assets:audio": "tsx scripts/import-audio.ts"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.17.0"
}
